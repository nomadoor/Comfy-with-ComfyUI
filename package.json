{
  "name": "comfy-with-comfyui",
  "version": "1.0.0",
  "type": "module",
  "description": "ComfyUI onboarding + workflow docs built with Eleventy, vanilla CSS, and ESM-only scripts.",
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=500 eleventy --serve --port=8080",
    "dev:media": "COMFY_MEDIA_PREVIEW_CHANGED=1 CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=500 eleventy --serve --port=8080",
    "build": "eleventy",
    "clean": "rimraf _site",
    "check": "npm run check:encoding && npm run check:content && npm run check:workflows && npm run check:runpod && npm run check:media && npm run check:assets && npm run test:unit && npm run test:python",
    "check:assets": "node scripts/check-esm.mjs && node scripts/check-icons.mjs",
    "check:content": "node scripts/check-frontmatter.mjs && node scripts/check-nav-integrity.mjs && node scripts/check-markdown-links.mjs",
    "check:encoding": "node scripts/check-utf8.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:runpod": "node runpod/tools/check.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:build": "node scripts/check-build-output.mjs",
    "compare:build": "node scripts/compare-build.mjs",
    "compare:styles": "node scripts/compare-styles.mjs",
    "views:update": "node scripts/update-page-views.mjs",
    "views:update:dry": "node scripts/update-page-views.mjs --dry-run",
    "media:sync": "node scripts/media-sync.mjs",
    "media:waf-expression": "node scripts/media-waf-expression.mjs",
    "test:server": "CHOKIDAR_USEPOLLING=1 CHOKIDAR_INTERVAL=500 COMFY_MEDIA_FIXTURES=1 COMFY_MEDIA_ORIGINALS= eleventy --serve --port=8091 --output=.cache/playwright-site",
    "test:playwright": "playwright test",
    "test:unit": "node --test scripts/lib/*.test.mjs workers/feedback/src/*.test.mjs functions/_lib/*.test.mjs",
    "test:python": "python3 -I -B -m unittest discover -s runpod/tests",
    "prepare": "node scripts/install-git-hooks.mjs",
    "runpod:refresh": "node runpod/tools/refresh.mjs"
  },
  "keywords": [
    "eleventy",
    "esm",
    "docs",
    "comfyui"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "fast-glob": "^3.3.3",
    "markdown-it": "^14.3.2",
    "prismjs": "^1.30.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "rimraf": "^6.1.3",
    "sharp": "0.35.4"
  }
}
