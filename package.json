{
  "name": "comfy-with-comfyui",
  "version": "1.0.0",
  "type": "module",
  "description": "ComfyUI onboarding + workflow docs built with Eleventy, vanilla CSS, and ESM-only scripts.",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve --port=8080",
    "dev:watch": "npx @11ty/eleventy --watch --output=_site",
    "dev:pages": "npx wrangler pages dev _site --port=8080 --compatibility-date=2026-02-17",
    "build": "eleventy --input=src --output=_site",
    "clean": "rimraf _site",
    "check": "npm run check:encoding && npm run check:content && npm run check:workflows && npm run check:assets",
    "check:all": "npm run check && npm run build && npm run test:playwright",
    "check:assets": "node scripts/check-esm.mjs && node scripts/check-icons.mjs",
    "check:content": "node scripts/check-frontmatter.mjs && node scripts/check-nav-integrity.mjs && node scripts/check-markdown-links.mjs",
    "check:encoding": "node scripts/check-utf8.mjs",
    "check:links": "STRICT_LINKS=1 node scripts/check-markdown-links.mjs",
    "check:icons": "STRICT_ICONS=1 node scripts/check-icons.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "views:update": "node scripts/update-page-views.mjs",
    "views:update:dry": "node scripts/update-page-views.mjs --dry-run",
    "test:playwright": "playwright test"
  },
  "keywords": [
    "eleventy",
    "esm",
    "docs",
    "comfyui"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "fast-glob": "^3.3.3",
    "prismjs": "^1.29.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "markdown-it": "^14.1.0",
    "rimraf": "^6.1.0"
  }
}
