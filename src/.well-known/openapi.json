{
  "openapi": "3.1.0",
  "info": {
    "title": "Comfy with ComfyUI Public Site Interfaces",
    "version": "1.0.0",
    "description": "Machine-readable descriptions for public, unauthenticated site resources and the operator contact endpoint."
  },
  "servers": [
    {
      "url": "https://comfyui.nomadoor.net"
    }
  ],
  "paths": {
    "/search/index-ja.json": {
      "get": {
        "operationId": "getJapaneseSearchIndex",
        "summary": "Japanese search index",
        "description": "Returns the static client-side search index for Japanese pages.",
        "responses": {
          "200": {
            "description": "Search index JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchIndex"
                }
              }
            }
          }
        }
      }
    },
    "/search/index-en.json": {
      "get": {
        "operationId": "getEnglishSearchIndex",
        "summary": "English search index",
        "description": "Returns the static client-side search index for English pages.",
        "responses": {
          "200": {
            "description": "Search index JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchIndex"
                }
              }
            }
          }
        }
      }
    },
    "/search/index-zh.json": {
      "get": {
        "operationId": "getChineseSearchIndex",
        "summary": "Chinese search index",
        "description": "Returns the static client-side search index for Chinese pages.",
        "responses": {
          "200": {
            "description": "Search index JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchIndex"
                }
              }
            }
          }
        }
      }
    },
    "/workflows/index.json": {
      "get": {
        "operationId": "getWorkflowCatalog",
        "summary": "Workflow catalog",
        "description": "Returns every ComfyUI workflow JSON the articles publish, with the articles that explain it, the models and custom nodes it needs, and the measured performance the article gives. Rebuilt with the site.",
        "responses": {
          "200": {
            "description": "Workflow catalog JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowCatalog"
                }
              }
            }
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "operationId": "submitContactMessage",
        "summary": "Submit a contact message",
        "description": "Accepts operator contact messages from the public contact page. Cloudflare Turnstile verification is required.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "reply_to",
                  "category",
                  "body",
                  "cf-turnstile-response"
                ],
                "properties": {
                  "reply_to": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "comfyui-consulting",
                      "genai-dev",
                      "business",
                      "other"
                    ]
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 10000
                  },
                  "environment": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "cf-turnstile-response": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "405": {
            "description": "Unsupported method",
            "headers": {
              "Allow": {
                "description": "The supported method for this endpoint.",
                "schema": {
                  "type": "string",
                  "const": "POST"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MethodNotAllowedError"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchIndex": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "url"
          ],
          "additionalProperties": true
        }
      },
      "ContactResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": true
      },
      "MethodNotAllowedError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "const": "method_not_allowed"
          },
          "message": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "error",
          "message",
          "resolution"
        ],
        "additionalProperties": false
      },
      "ServerError": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "enum": [
              "config",
              "server"
            ]
          }
        },
        "required": [
          "ok",
          "error"
        ],
        "additionalProperties": true
      },
      "WorkflowCatalog": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer"
          },
          "site": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "updated": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Last day the workflow's build changed (YYYY-MM-DD). Filling in model or custom node metadata does not move it."
                },
                "articles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "lang": {
                        "type": "string"
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "url": {
                        "type": "string"
                      },
                      "heading": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                },
                "performance": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "directory": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "size": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "File size as the workflow's note gives it (note models only)."
                      },
                      "source": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "loaders",
                          "note",
                          null
                        ]
                      }
                    }
                  }
                },
                "models_source": {
                  "type": "string",
                  "enum": [
                    "loaders",
                    "note",
                    "names_only",
                    "none"
                  ]
                },
                "custom_nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "registry",
                          "github"
                        ]
                      }
                    }
                  }
                }
              },
              "required": [
                "name",
                "url",
                "articles"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "schema_version",
          "workflows"
        ],
        "additionalProperties": true
      }
    }
  }
}
