{% from "icon.njk" import icon %}
{% set listItems = navItems or items or [] %}
{% set listSectionKey = navSectionKey or sectionKey or currentSection %}
{% set listLang = lang or currentLang or site.defaultLang %}
{% set listCurrentId = currentId or currentNavId %}
<ul class="nav-list">
  {% for item in listItems %}
  <li class="nav-list__item">
    {% if item.archive %}
    {# The only folding heading: closed unless the current page is inside (ADR 2026-10-17-nav-archive). #}
    <details class="nav-list__archive" {% if item | navContains(listCurrentId) %}open{% endif %}>
      <summary class="nav-list__no-link nav-list__archive-summary">
        <span class="nav-list__label">{{ item.title }}</span>
        <span class="nav-list__archive-caret" aria-hidden="true">{{ icon("chevron-down") }}</span>
      </summary>
      <div class="nav-list__children">
        {% set navItems = item.children %}
        {% include "nav-list.njk" %}
      </div>
    </details>
    {% elif item.noLink %}
    <span class="nav-list__no-link">
      <span class="nav-list__label">{{ item.title }}</span>
    </span>
    {% else %}
    {% set url = "/" + listLang + "/" + listSectionKey + "/" + item.id + "/" %}
    {% set isPick = navPickUrls and url in navPickUrls %}
    <a href="{{ url }}" class="nav-list__link{% if isPick %} nav-list__link--pick{% endif %}{% if item.id == listCurrentId %} is-active{% endif %}" {% if
      item.id==listCurrentId %}aria-current="page" {% endif %}>
      {% if isPick %}<span class="nav-list__pick-icon">{{ icon("sparkles") }}</span>{% endif %}
      <span class="nav-list__label">{{ item.title }}</span>
    </a>
    {% endif %}
    {% if item.children and not item.archive %}
    <div class="nav-list__children">
      {% set navItems = item.children %}
      {% include "nav-list.njk" %}
    </div>
    {% endif %}
  </li>
  {% endfor %}
</ul>