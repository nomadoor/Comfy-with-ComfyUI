{% set heroBlock = hero or {} %}
{% set heroImage = heroBlock.image %}
{% set heroMedia = heroImage and (heroImage | resolveMedia({ size: 1200 })) %}
{% set isHeroVideo = heroMedia and heroMedia.kind == "video" %}
<div class="hero{% if heroImage %} hero--has-media{% endif %}">
  {% if heroImage and isHeroVideo %}
    <video
      class="hero__media"
      src="{{ heroMedia.src }}"
      {% if heroMedia.poster %}poster="{{ heroMedia.poster }}"{% endif %}
      muted
      autoplay
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    ></video>
  {% elif heroMedia %}
    <img
      src="{{ heroMedia.src }}"
      {% if heroMedia.fullSrc != heroMedia.src %}data-full-src="{{ heroMedia.fullSrc }}"{% endif %}
      {% if heroMedia.srcset %}
        srcset="{{ heroMedia.srcset }}"
        sizes="(min-width: 1100px) 960px, 100vw"
      {% endif %}
      alt="{{ heroBlock.alt or title }}"
      class="hero__media"
      width="1440"
      height="480"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  {% endif %}
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__content">
    <h1 class="hero__title">{{ title }}</h1>
    {% include "tag-chips.njk" %}
  </div>
</div>
