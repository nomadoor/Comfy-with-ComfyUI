{% set currentLang = lang | default(site.defaultLang) -%}
{% set localeNav = nav[currentLang] or nav[site.defaultLang] -%}
{% set sectionCandidate = section -%}
{% set sectionExists = false -%}
{% if sectionCandidate and localeNav -%}
{% for item in localeNav.sections -%}
{% if item.key == sectionCandidate -%}
{% set sectionExists = true -%}
{% endif -%}
{% endfor -%}
{% endif -%}
{% set currentSection = sectionExists and sectionCandidate or (localeNav.sections[0].key if localeNav and
localeNav.sections else site.sections[0].key) -%}
{% set currentNavId = navId | default(slug) -%}
{% set headingAnchorI18n = site.i18n.headingAnchor or {} -%}
{% set headingAnchorCopyLabel = headingAnchorI18n.copyLabel[currentLang] or
headingAnchorI18n.copyLabel[site.defaultLang] or "Copy heading link" -%}
{% set headingAnchorCopiedLabel = headingAnchorI18n.copiedLabel[currentLang] or
headingAnchorI18n.copiedLabel[site.defaultLang] or "Copied" -%}
{% set pageSummary = summary | default('Comfy with ComfyUI docs') -%}
{% set siteUrl = site.url or '' -%}
{% set pagePath = page.url or '' -%}
{% set canonicalUrl = pagePath -%}
{% if siteUrl and pagePath -%}
{% set canonicalUrl = siteUrl ~ pagePath -%}
{% endif -%}
{% set heroBlock = hero or {} -%}
{% set heroImage = heroBlock.image -%}
{% set heroImageNormalized = heroImage | stripUrlQuery -%}
{% set heroVariant = heroImageNormalized | imageVariant(1200) -%}
{% set candidateImage = heroVariant.preview -%}
{% set isVideo = candidateImage and ('.mp4' in (candidateImage | lower)) -%}
{% set ogImagePath = candidateImage -%}
{% if isVideo and candidateImage -%}
{% set ogImagePath = candidateImage | replace(".mp4", ".jpg") | replace(".MP4", ".jpg") -%}
{% endif -%}
{% set ogImage = ogImagePath if ogImagePath else (site.ogImage or '') -%}
{% if ogImagePath and siteUrl -%}
{% set ogStartsWithSlash = (ogImagePath | first) == '/' -%}
{% if ogStartsWithSlash -%}
{% set ogImage = siteUrl ~ ogImagePath -%}
{% endif -%}
{% endif -%}
<!DOCTYPE html>
<html lang="{{ currentLang }}">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>
    document.documentElement.classList.add("js");
  </script>
  <title>{{ title | e }} | {{ (site.name[currentLang] or site.name[site.defaultLang]) | e }}</title>
  <meta name="description" content="{{ pageSummary | e }}" />
  {% if canonicalUrl %}
  <link rel="canonical" href="{{ canonicalUrl | e }}" />
  {% endif %}
  {% if canonicalUrl %}
  <meta property="og:url" content="{{ canonicalUrl | e }}" />
  {% endif %}
  <meta property="og:title" content="{{ title | e }}" />
  <meta property="og:description" content="{{ pageSummary | e }}" />
  {% if ogImage %}
  <meta property="og:image" content="{{ ogImage | e }}" />
  {% endif %}
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="{{ (site.name[currentLang] or site.name[site.defaultLang]) | e }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ title | e }}" />
  <meta name="twitter:description" content="{{ pageSummary | e }}" />
  {% if ogImage %}
  <meta name="twitter:image" content="{{ ogImage | e }}" />
  {% endif %}
  {% set langOptions = site.languages or [] -%}
  {% set currentSlug = currentNavId or slug -%}
{% set isStandalone = (not sectionExists) and (currentSlug == 'news' or currentSlug == 'about' or currentSlug == 'contact') -%}
  {% set hreflangSection = sectionCandidate or currentSection -%}
  {% for option in langOptions -%}
    {% if isStandalone -%}
      {% set altPath = '/' + option.code + '/' + currentSlug + '/' -%}
    {% else -%}
      {% set altPath = '/' + option.code + '/' + hreflangSection + '/' + currentSlug + '/' -%}
    {% endif -%}
    {% set altUrl = siteUrl and (siteUrl ~ altPath) or altPath -%}
  <link rel="alternate" hreflang="{{ option.code }}" href="{{ altUrl | e }}" />
  {% endfor -%}
  {% if isStandalone -%}
    {% set defaultPath = '/' + site.defaultLang + '/' + currentSlug + '/' -%}
  {% else -%}
    {% set defaultPath = '/' + site.defaultLang + '/' + hreflangSection + '/' + currentSlug + '/' -%}
  {% endif -%}
  {% set defaultUrl = siteUrl and (siteUrl ~ defaultPath) or defaultPath -%}
  <link rel="alternate" hreflang="x-default" href="{{ defaultUrl | e }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Zen+Kaku+Gothic+New:wght@400;500;600&display=swap" />
  <link rel="stylesheet" href="/assets/css/site.css" />
  <link rel="icon" type="image/png" sizes="128x128" href="/assets/logos/favicon/favicon_128.png" />
  <link rel="icon" type="image/png" sizes="256x256" href="/assets/logos/favicon/favicon_256.png" />
</head>

<body lang="{{ currentLang }}" id="top" data-heading-anchor-copy-label="{{ headingAnchorCopyLabel | escape }}"
  data-heading-anchor-copied-label="{{ headingAnchorCopiedLabel | escape }}">
  {% include "header.njk" %}
  <div class="nav-backdrop" aria-hidden="true"></div>
  <div class="app-shell">
    <aside class="app-shell__sidebar" id="sidebar">
      <div class="rail rail--sidebar">
        {% include "sidebar.njk" %}
      </div>
    </aside>
    <main class="app-shell__content transition-fade" id="page">
      <div class="js-fallback-notice" data-js-fallback-notice role="status" aria-live="polite">
        <div class="js-fallback-notice__inner">
          {% if currentLang == "ja" %}
            JavaScriptが利用できないため、メニューや検索など一部機能は利用できません。ブラウザや拡張機能の設定を確認してください。
          {% elif currentLang == "zh" %}
            由于 JavaScript 不可用，菜单和搜索等部分功能不可用。请检查浏览器或扩展设置。
          {% else %}
            JavaScript is unavailable, so some features (menu/search) are unavailable. Check browser or extension settings.
          {% endif %}
        </div>
      </div>
      <div class="app-shell__content-scroll">
        {{ content | safe }}
      </div>
    </main>
    <aside class="app-shell__toc">
      <div class="rail rail--toc">
        {% include "toc.njk" %}
      </div>
    </aside>
  </div>
  <script type="module" src="/assets/js/app.js"></script>
</body>

</html>
