{% set currentLang = lang | default(site.defaultLang) -%}
{% set localeNav = nav[currentLang] or nav[site.defaultLang] -%}
{% set sectionCandidate = section -%}
{% set sectionExists = false -%}
{% if sectionCandidate and localeNav -%}
  {% for item in localeNav.sections -%}
    {% if item.key == sectionCandidate -%}
      {% set sectionExists = true -%}
    {% endif -%}
  {% endfor -%}
{% endif -%}
{% set currentSection = sectionExists and sectionCandidate or (localeNav.sections[0].key if localeNav and localeNav.sections else site.sections[0].key) -%}
{% set currentNavId = navId | default(slug) -%}
{% set headingAnchorI18n = site.i18n.headingAnchor or {} -%}
{% set headingAnchorCopyLabel = headingAnchorI18n.copyLabel[currentLang] or headingAnchorI18n.copyLabel[site.defaultLang] or "Copy heading link" -%}
{% set headingAnchorCopiedLabel = headingAnchorI18n.copiedLabel[currentLang] or headingAnchorI18n.copiedLabel[site.defaultLang] or "Copied" -%}
{% set pageSummary = summary | default('Comfy with ComfyUI docs') -%}
{% set siteUrl = site.url or '' -%}
{% set pagePath = page.url or '' -%}
{% set canonicalUrl = pagePath -%}
{% if siteUrl and pagePath -%}
  {% set canonicalUrl = siteUrl ~ pagePath -%}
{% endif -%}
{% set heroBlock = hero or {} -%}
{% set heroImage = heroBlock.image -%}
{% set heroImageNormalized = heroImage | stripUrlQuery -%}
{% set isHeroVideo = heroImageNormalized and ('.mp4' in (heroImageNormalized | lower)) -%}
{% set ogImagePath = heroImageNormalized if (heroImageNormalized and (not isHeroVideo)) else (site.ogImage or '') -%}
{% set ogImage = ogImagePath -%}
{% if ogImagePath and siteUrl -%}
  {% set ogStartsWithSlash = (ogImagePath | first) == '/' -%}
  {% if ogStartsWithSlash -%}
    {% set ogImage = siteUrl ~ ogImagePath -%}
  {% endif -%}
{% endif -%}
<!DOCTYPE html>
<html lang="{{ currentLang }}">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title | e }} | {{ (site.name[currentLang] or site.name[site.defaultLang]) | e }}</title>
  <meta name="description" content="{{ pageSummary | e }}" />
  {% if canonicalUrl %}
  <meta property="og:url" content="{{ canonicalUrl | e }}" />
  {% endif %}
  <meta property="og:title" content="{{ title | e }}" />
  <meta property="og:description" content="{{ pageSummary | e }}" />
  {% if ogImage %}
  <meta property="og:image" content="{{ ogImage | e }}" />
  {% endif %}
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="{{ (site.name[currentLang] or site.name[site.defaultLang]) | e }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ title | e }}" />
  <meta name="twitter:description" content="{{ pageSummary | e }}" />
  {% if ogImage %}
  <meta name="twitter:image" content="{{ ogImage | e }}" />
  {% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Zen+Kaku+Gothic+New:wght@400;500;600&display=swap" />
  <link rel="stylesheet" href="/assets/css/site.css" />
  <link rel="icon" type="image/png" sizes="128x128" href="/assets/logos/favicon/favicon_128.png" />
  <link rel="icon" type="image/png" sizes="256x256" href="/assets/logos/favicon/favicon_256.png" />
</head>

<body
  lang="{{ currentLang }}"
  id="top"
  data-heading-anchor-copy-label="{{ headingAnchorCopyLabel | escape }}"
  data-heading-anchor-copied-label="{{ headingAnchorCopiedLabel | escape }}"
>
  {% include "header.njk" %}
  <div class="nav-backdrop" aria-hidden="true"></div>
  <div class="app-shell">
    <aside class="app-shell__sidebar" id="sidebar">
      <div class="rail rail--sidebar">
        {% include "sidebar.njk" %}
      </div>
    </aside>
    <main class="app-shell__content transition-fade" id="page">
      {{ content | safe }}
    </main>
    <aside class="app-shell__toc">
      <div class="rail rail--toc">
        {% include "toc.njk" %}
      </div>
    </aside>
  </div>
  <script type="module" src="/assets/js/app.js"></script>
</body>

</html>
