{% set currentLang = lang | default(site.defaultLang) -%}
{% set localeNav = nav[currentLang] or nav[site.defaultLang] -%}
{% set sectionCandidate = section -%}
{% set sectionExists = false -%}
{% if sectionCandidate and localeNav -%}
{% for item in localeNav.sections -%}
{% if item.key == sectionCandidate -%}
{% set sectionExists = true -%}
{% endif -%}
{% endfor -%}
{% endif -%}
{% set currentSection = sectionExists and sectionCandidate or (localeNav.sections[0].key if localeNav and
localeNav.sections else site.sections[0].key) -%}
{% set currentNavId = navId | default(slug) -%}
{% set headingAnchorI18n = site.i18n.headingAnchor or {} -%}
{% set headingAnchorCopyLabel = headingAnchorI18n.copyLabel[currentLang] or
headingAnchorI18n.copyLabel[site.defaultLang] or "Copy heading link" -%}
{% set headingAnchorCopiedLabel = headingAnchorI18n.copiedLabel[currentLang] or
headingAnchorI18n.copiedLabel[site.defaultLang] or "Copied" -%}
{% set pageSummary = summary | default('Comfy with ComfyUI docs') -%}
{% set searchTitle = seoTitle or title -%}
{% set searchDescription = seoDescription or pageSummary -%}
{% set siteUrl = site.url or '' -%}
{% set pagePath = page.url or '' -%}
{% set canonicalUrl = pagePath -%}
{% if siteUrl and pagePath -%}
{% set canonicalUrl = siteUrl ~ pagePath -%}
{% endif -%}
{% set heroBlock = hero or {} -%}
{% set heroImage = heroBlock.image -%}
{% set heroImageNormalized = heroImage | stripUrlQuery -%}
{% set heroMedia = heroImageNormalized | resolveMedia({ size: 1200 }) -%}
{% set ogImagePath = heroMedia.og or heroMedia.poster -%}
{% set ogImage = ogImagePath if ogImagePath else (site.ogImage or '') -%}
{% if ogImage and siteUrl and (ogImage | first) == '/' -%}
{% set ogImage = siteUrl ~ ogImage -%}
{% endif -%}
{% set isArticle = sectionExists and created and not searchExclude and not ('noindex' in (robots or '')) -%}
<!DOCTYPE html>
<html lang="{{ currentLang }}" data-asset-version="{{ env.assetVersion | e }}">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>
    document.documentElement.classList.add("js");
  </script>
  <title>{{ searchTitle | e }} | {{ (site.name[currentLang] or site.name[site.defaultLang]) | e }}</title>
  {# data-page-meta marks tags that differ per page; the router swaps them on navigation. #}
  {% if searchDescription %}
  <meta name="description" content="{{ searchDescription | e }}" data-page-meta />
  {% endif %}
  {% if robots %}
  <meta name="robots" content="{{ robots | e }}" data-page-meta />
  {% endif %}
  {% if canonicalUrl %}
  <link rel="canonical" href="{{ canonicalUrl | e }}" data-page-meta />
  {% endif %}
  {% if canonicalUrl %}
  <meta property="og:url" content="{{ canonicalUrl | e }}" data-page-meta />
  {% endif %}
  <meta property="og:title" content="{{ searchTitle | e }}" data-page-meta />
  {% if searchDescription %}
  <meta property="og:description" content="{{ searchDescription | e }}" data-page-meta />
  {% endif %}
  {% if ogImage %}
  <meta property="og:image" content="{{ ogImage | e }}" data-page-meta />
  {% endif %}
  <meta property="og:type" content="article" data-page-meta />
  {% if isArticle %}
  <meta property="article:published_time" content="{{ created | isoDate }}" data-page-meta />
  <meta property="article:modified_time" content="{{ (updated or created) | isoDate }}" data-page-meta />
  <meta name="author" content="{{ site.author.name | e }}" data-page-meta />
  {% endif %}
  <meta property="og:site_name" content="{{ (site.name[currentLang] or site.name[site.defaultLang]) | e }}" data-page-meta />
  <meta name="twitter:card" content="{{ 'summary_large_image' if ogImagePath else 'summary' }}" data-page-meta />
  <meta name="twitter:title" content="{{ searchTitle | e }}" data-page-meta />
  {% if searchDescription %}
  <meta name="twitter:description" content="{{ searchDescription | e }}" data-page-meta />
  {% endif %}
  {% if ogImage %}
  <meta name="twitter:image" content="{{ ogImage | e }}" data-page-meta />
  {% endif %}
  {% if canonicalUrl and pagePath != "/404.html" %}
  {% set structuredData = {
    "siteUrl": siteUrl,
    "canonicalUrl": canonicalUrl,
    "lang": currentLang,
    "siteName": site.name[currentLang] or site.name[site.defaultLang],
    "title": title,
    "description": searchDescription,
    "author": site.author,
    "article": {
      "datePublished": created | isoDate,
      "dateModified": (updated or created) | isoDate,
      "image": ogImage if ogImagePath else ""
    } if isArticle else null
  } | pageStructuredData %}
  <script type="application/ld+json" data-page-meta>{{ structuredData | jsonLd | safe }}</script>
  {% endif %}
  {% if sectionCandidate != 'missing' and not ('noindex' in (robots or '')) -%}
  {% for alt in pagePath | hreflangAlternates(site.languages, collections.all, site.defaultLang) -%}
  <link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ siteUrl ~ alt.href | e }}" data-page-meta />
  {% endfor -%}
  {% endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Zen+Kaku+Gothic+New:wght@400;500;600&display=swap" />
  <link rel="stylesheet" href="/assets/css/site.css?v={{ env.assetVersion | e }}" />
  <link rel="icon" type="image/png" sizes="128x128" href="/assets/logos/favicon/favicon_128.png" />
  <link rel="icon" type="image/png" sizes="256x256" href="/assets/logos/favicon/favicon_256.png" />
</head>

<body lang="{{ currentLang }}" id="top" data-heading-anchor-copy-label="{{ headingAnchorCopyLabel | escape }}"
  data-heading-anchor-copied-label="{{ headingAnchorCopiedLabel | escape }}">
  {% include "header.njk" %}
  <div class="nav-backdrop" aria-hidden="true"></div>
  <div class="app-shell">
    <aside class="app-shell__sidebar" id="sidebar">
      <div class="rail rail--sidebar">
        {% include "sidebar.njk" %}
      </div>
    </aside>
    <main class="app-shell__content transition-fade" id="page">
      <div class="app-shell__content-corner-mask" aria-hidden="true"></div>
      <div class="js-fallback-notice" data-js-fallback-notice role="status" aria-live="polite">
        <div class="js-fallback-notice__inner">
          {% if currentLang == "ja" %}
            JavaScriptが利用できないため、メニューや検索など一部機能は利用できません。ブラウザや拡張機能の設定を確認してください。
          {% elif currentLang == "zh" %}
            由于 JavaScript 不可用，菜单和搜索等部分功能不可用。请检查浏览器或扩展设置。
          {% else %}
            JavaScript is unavailable, so some features (menu/search) are unavailable. Check browser or extension settings.
          {% endif %}
        </div>
      </div>
      <div class="app-shell__content-scroll">
        {{ content | safe }}
      </div>
    </main>
    <aside class="app-shell__toc">
      <div class="rail rail--toc">
        {% include "toc.njk" %}
      </div>
    </aside>
  </div>
  <script type="module" src="/assets/js/{{ env.assetVersion | e }}/app.js"></script>
</body>

</html>
