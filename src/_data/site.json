        {
          "id": "form-correction",
          "type": "form",
          "title": {
            "ja": "このページに間違いがあります！",
            "en": "This page has an issue!",
            "zh": "这个页面有问题！"
          },
          "summary": {
            "ja": "見つけた誤りや更新漏れを報告してください。",
            "en": "Report mistakes or outdated instructions.",
            "zh": "反馈错误或过期内容。"
          },
          "body": {
            "ja": "再現手順や正しい情報を添えてもらえると助かります。現在のURLは自動で添付されます。",
            "en": "Include a short repro step or the correct information if you can. We attach the current URL automatically.",
            "zh": "请尽量提供复现步骤或正确信息，当前 URL 会自动附上。"
          },
          "form": {
            "placeholder": {
              "ja": "どこが誤っているのか、何を確認したかを書いてください。",
              "en": "Describe what is incorrect and how you verified it.",
              "zh": "请说明哪里不正确，以及你如何验证的。"
            },
            "successDetail": {
              "ja": "誤り報告",
              "en": "Correction report",
              "zh": "错误反馈"
            },
            "attachUrl": true,
            "minLength": 20
          }
        },
        {
          "id": "form-request",
          "type": "form",
          "title": {
            "ja": "これについても書いてください！",
            "en": "Please explain more!",
            "zh": "请补充讲解！"
          },
          "summary": {
            "ja": "足りない解説やサンプルを提案できます。",
            "en": "Suggest missing explanations or workflows.",
            "zh": "提出缺少的说明或示例。"
          },
          "body": {
            "ja": "欲しいトピックや使いたいモデル名など、背景が分かるように教えてください。",
            "en": "Tell us what topic or model you need so we can plan the write-up.",
            "zh": "请说明想看的主题或模型名称，便于我们安排。"
          },
          "form": {
            "placeholder": {
              "ja": "例: Flux.1 Tools の設定を詳しく知りたい",
              "en": "Example: Need more detail on Flux.1 Tools settings",
              "zh": "例：想了解 Flux.1 Tools 的详细设置"
            },
            "successDetail": {
              "ja": "追記リクエスト",
              "en": "Expansion request",
              "zh": "补充请求"
            },
            "attachUrl": true,
            "minLength": 20
          }
