#!/bin/sh
# Record the day each staged workflow's build changed (src/workflows/**, see scripts/workflow-dates.mjs),
# then upload new or changed media referenced by staged site sources (and the sample inputs of the RunPod
# profiles' workflows), then stage the updated manifests.
# Skip once with: SKIP_MEDIA_SYNC=1 git commit ...

# `git commit -- <path>` runs the hook on a temporary index: what the hook stages goes into that commit
# but not into the real index, so the next commit would silently undo it.
case "$GIT_INDEX_FILE" in
  *next-index*)
    if git -c core.quotePath=false diff --cached --name-only | grep -qE '^src/(content|_data|includes|layouts|workflows)/|^src/[^/]+\.(md|njk)$|^runpod/profiles/'; then
      echo "[pre-commit] commit with paths (git commit -- <path>) cannot update the manifests; git add the files, then git commit" >&2
      exit 1
    fi
    ;;
esac

if git -c core.quotePath=false diff --cached --name-only | grep -q '^src/workflows/'; then
  # The hook stages workflowDates.json in full below, so an unstaged hand edit there would slip in.
  if ! git diff --quiet -- src/_data/workflowDates.json; then
    echo "[pre-commit] src/_data/workflowDates.json has unstaged changes; stage or discard them first" >&2
    exit 1
  fi
  if ! node scripts/workflow-dates.mjs --staged; then
    echo "[pre-commit] workflow-dates failed; commit aborted" >&2
    exit 1
  fi
  git add src/_data/workflowDates.json
fi

[ "$SKIP_MEDIA_SYNC" = "1" ] && exit 0

if ! git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR | grep -qE '^src/(content|_data|includes|layouts|workflows)/|^src/[^/]+\.(md|njk)$|^runpod/profiles/'; then
  exit 0
fi

# The hook stages media.json in full below, so an unstaged hand edit there would slip into the commit.
if ! git diff --quiet -- src/_data/media.json; then
  echo "[pre-commit] src/_data/media.json has unstaged changes; stage or discard them first" >&2
  exit 1
fi

echo "[pre-commit] media:sync"
# --staged: read references from the index, so unstaged edits cannot change what gets uploaded/recorded.
if ! node scripts/media-sync.mjs --staged; then
  echo "[pre-commit] media:sync failed; commit aborted (fix the errors above, or SKIP_MEDIA_SYNC=1 to bypass)" >&2
  exit 1
fi

git add src/_data/media.json
